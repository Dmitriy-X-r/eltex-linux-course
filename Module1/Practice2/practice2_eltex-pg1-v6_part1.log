# cat > /usr/local/bin/dmesg-user2.sh
#!/bin/bash
/usr/bin/dmesg
# chown root:root /usr/local/bin/dmesg-user2.sh
# chmod 4755 /usr/local/bin/dmesg-user2.sh
-rwsr-xr-x 1 root root 27 Oct 19 06:23 /usr/local/bin/dmesg-user2.sh

# su - user2 -c '/usr/local/bin/dmesg-user2.sh 2>&1 | head -n 3'
dmesg: read kernel buffer failed: Operation not permitted

Результат: sudo для user1 работает. Попытка запуска dmesg через Bash-скрипт с SUID для user2 не сработала: Operation not permitted. Linux не применяет SUID к интерпретируемым скриптам, поэтому скрипт не получает привилегии root.

