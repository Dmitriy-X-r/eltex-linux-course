4) Поиск пользователей с оболочкой /usr/sbin/nologin

# awk -F: '
NR == FNR {
    group_name[$3] = $1

    if ($4 != "") {
        n = split($4, members, ",")
        for (i = 1; i <= n; i++) {
            in_group[members[i], $1] = 1
        }
    }
    next
}
$7 == "/usr/sbin/nologin" {
    uid = $3
    username = $1
    groups = ""

    for (gid in group_name) {
        if (gid == $4 || in_group[username, group_name[gid]]) {
            groups = groups (groups == "" ? "" : ",") group_name[gid]
        }
    }

    print uid, username, groups
}' /etc/group /etc/passwd | sort -k1,1nr

