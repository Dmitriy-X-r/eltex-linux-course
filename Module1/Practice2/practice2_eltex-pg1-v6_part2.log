2) Поиск источников и сообщений в auth.log

# find / -type f -name auth.log
/var/log/auth.log

Команда обработки файла:
# awk '{
    source = $3
    sub(/:$/, "", source)
    message = ""
    for (i = 4; i <= NF; i++) {
        message = message (i == 4 ? "" : " ") $i
    }
    print source, message
}' /var/log/auth.log |
sed -E 's/\[[0-9]+\]//' |
sort -k1,1 -k2,2 |
awk '{
    source = $1
    $1 = ""
    sub(/^ /, "")
    if (source != previous) {
        if (NR > 1) print ""
        print source
        previous = source
    }
    print "  " $0
}'

Примечание: Я специально вынес все заголовки и скрыл большую часть однотипных записей, чтобы этот вывод был более менее читаемый

